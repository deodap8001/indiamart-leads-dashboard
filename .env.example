# Copy this file to .env and fill in your actual values

INDIAMART_API_KEY=your_glusr_crm_key_here

# Database (MariaDB / MySQL)
DB_HOST=your-db-host.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASS=your_db_password
DB_NAME=indiamart_dashboard

# SSH Tunnel (only if DB is behind VPC / bastion)
SSH_HOST=your.bastion.ip
SSH_PORT=22
SSH_USER=ubuntu
SSH_LOCAL_PORT=3307

# Pick ONE of these two for the SSH private key:
# (a) Local development — file path on your machine:
SSH_KEY_PATH=C:\path\to\private_key.pem
# (b) Production (Render etc.) — paste the full .pem file content:
# SSH_KEY_CONTENT=-----BEGIN RSA PRIVATE KEY-----\n...key body...\n-----END RSA PRIVATE KEY-----

# Session signing (generate a long random string)
SECRET_KEY=replace_with_random_50_char_string
